# Copy this file to '.env' in this same directory and adjust the values.
# Lines starting with '#' are ignored. Windows paths do NOT need escaped backslashes.
# Real environment variables with the same name take precedence over this file.
# Both settings are required: the tools fail fast when one of them is missing.

# Root directory that holds the COGNYTE and vigiang working folders.
WORK_PATH=C:\work-folder

# Local '.bashrc' that receives the generated vigiang aliases.
USER_BASHRC_PATH=C:\Users\your-user\.bashrc
